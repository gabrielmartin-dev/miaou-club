{
  "name": "miaou-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && npm run check:server",
    "build": "astro build && npm run build:server",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts && npm run benchmark:models:check",
    "verify": "npm run format:check && npm run lint && npm run test && npm run check && npm run build && npm run build:storybook",
    "verify:quiet": "node scripts/quiet.mjs npm run verify",
    "dev:docker": "astro dev --host 0.0.0.0",
    "check:server": "tsc -p server/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate --config server/drizzle.config.ts",
    "db:auth-schema": "auth generate --config server/auth.config.ts --output server/src/infrastructure/db/auth-schema.ts --yes",
    "db:migrate": "tsx server/src/infrastructure/db/migrate.ts",
    "db:up": "docker compose up -d --wait db",
    "db:test:up": "docker compose --profile test up -d --wait db-test",
    "db:stop": "docker compose --profile test stop db db-test",
    "test:server": "tsx --test server/tests/*.test.ts",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build:storybook": "storybook build --disable-telemetry",
    "test:e2e": "playwright test",
    "verify:full": "npm run verify && npm run test:server && npm run test:e2e && npm run security:audit && npm run security:secrets && npm run security:workflows",
    "security:audit": "npm audit --audit-level=high",
    "hooks:install": "git config core.hooksPath .githooks",
    "build:server": "tsc -p server/tsconfig.build.json && mkdir -p dist/drizzle && cp -R server/drizzle/. dist/drizzle",
    "start": "node server/start.mjs",
    "security:secrets": "docker run --rm -v \"$PWD:/repo:ro\" ghcr.io/gitleaks/gitleaks:v8.30.0 dir /repo --config /repo/.gitleaks.toml --redact --no-banner",
    "security:image": "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v miaou-trivy-cache:/root/.cache aquasec/trivy:0.75.0 image --quiet --severity HIGH,CRITICAL --scanners vuln --exit-code 1 miaou-lot1:local",
    "security:workflows": "docker run --rm -v \"$PWD/.github/workflows:/work:ro\" -w /work rhysd/actionlint:1.7.12 ci.yml promotion-preflight.yml backup-rehearsal.yml deploy-preproduction.yml",
    "test:image": "node scripts/smoke-image.mjs",
    "accounts:ops": "tsx server/src/ops/accounts.ts",
    "accounts:cleanup": "tsx server/src/ops/cleanup.ts",
    "media:maintenance": "tsx server/src/ops/media.ts",
    "data:maintenance": "tsx server/src/ops/data.ts",
    "candidate:verify": "node scripts/candidate.mjs",
    "preproduction:check": "node scripts/preproduction-config.mjs",
    "candidate:load": "node scripts/load-candidate.mjs",
    "recovery:local": "tsx server/src/ops/recovery-cli.ts",
    "recovery:rehearse": "tsx --test server/tests/recovery.test.ts",
    "benchmark:models": "node scripts/model-benchmark.mjs",
    "benchmark:models:check": "node scripts/model-benchmark.mjs --self-test",
    "backup:remote": "node --import tsx scripts/backup-remote-runner.mjs",
    "backup:rehearse": "node --import tsx --test server/backup-tests/*.test.ts tests/remote-backup-repository.test.mjs tests/backup-render-quiescence.test.mjs tests/backup-remote-runner.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.12",
    "canvas-confetti": "1.9.4",
    "dotenv": "^18.0.8",
    "maplibre-gl": "6.16.0",
    "motion": "14.7.1",
    "oxc-transform-react": "0.145.0",
    "proj4": "2.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "auth": "1.7.14",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "storybook": "10.6.4",
    "tsx": "4.23.15",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "workspaces": [
    "server",
    "packages/contracts"
  ]
}
